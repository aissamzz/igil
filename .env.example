# ─────────────────────────────────────────────
# Igil — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── AI ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Claude (reasoning, copywriting, research)
OPENAI_API_KEY=sk-...                 # GPT-4o / Codex (demo code generation)

# ── Scraping ──────────────────────────────────
OUTSCRAPER_API_KEY=                   # Fallback scraper if Barty-Bart fails

# ── Research ──────────────────────────────────
BRAVE_API_KEY=                        # Brave Search API (niche competitor research)

# ── Storage ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...              # Public anon key (read-only client ops)
SUPABASE_SERVICE_KEY=eyJ...           # Service role key (server-side writes)

# ── Deployment ────────────────────────────────
COOLIFY_BASE_URL=https://coolify.yourdomain.com
COOLIFY_API_TOKEN=                    # Settings → API Tokens in Coolify dashboard

# ── Version Control ───────────────────────────
GITHUB_TOKEN=ghp_...                  # Personal access token, repo scope
GITHUB_USERNAME=                      # Your GitHub username (e.g. aissamzz)

# ── Notifications ─────────────────────────────
TELEGRAM_BOT_TOKEN=                   # From BotFather: /newbot
TELEGRAM_CHAT_ID=                     # Your personal chat ID (message @userinfobot)

# ── Pipeline Limits ───────────────────────────
MAX_LEADS_PER_NICHE=100
MAX_DEMOS_PER_RUN=30
SCORE_THRESHOLD=60
